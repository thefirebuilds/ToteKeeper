{
  "name": "totekeeper-monorepo",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "node scripts/dev.mjs api",
    "dev:worker": "node scripts/dev.mjs worker",
    "build:web": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web test",
    "check:web": "npm --prefix apps/web run typecheck && npm --prefix apps/web run lint",
    "check:connectivity": "node scripts/connectivity.mjs"
  }
}
