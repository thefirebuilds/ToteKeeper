{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "bundler",
    "types": ["node"], "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "strict": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["server/**/*.ts"]
}
