# Local Docker development. Never reuse these settings in production.
DEBUG=true
USE_SQLITE=false
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=octagon
POSTGRES_USER=octagon
# Generate a unique password before starting Compose.
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Leave EMAIL_BACKEND unset locally for console email output.
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=local@example.invalid
DOMAIN=
ACME_EMAIL=
