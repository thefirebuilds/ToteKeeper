# Dedicated server configuration. Fill credentials locally; never commit the real .env.
DEBUG=false
USE_SQLITE=false
SECRET_KEY=
ALLOWED_HOSTS=totekeeper.com,portal.totekeeper.com
CSRF_TRUSTED_ORIGINS=https://totekeeper.com,https://portal.totekeeper.com
POSTGRES_DB=octagon
POSTGRES_USER=octagon
# Generate a unique password before starting Compose.
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Production SMTP backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=local@example.invalid
ACME_EMAIL=
PUBLIC_BASE_URL=https://portal.totekeeper.com
# Generate separately with cryptography.fernet.Fernet.generate_key().
MFA_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
# Real contact details must be supplied before launch.
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_HOURS=
SERVICE_TIMEZONE=America/Chicago

# Two distinct real DNS hostnames, without protocol. Replace examples.
WEB_DOMAIN=totekeeper.com
PORTAL_DOMAIN=portal.totekeeper.com

# Optional HTTPS email transport (instead of SMTP):
# EMAIL_BACKEND=config.gmail.GmailAPIBackend
# DEFAULT_FROM_EMAIL=your-authorized-sender@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Public inquiry inbox: intended blake@totekeeper.com; set a monitored address to enable.
INQUIRY_TO_EMAIL=
# true only behind supplied Caddy, which overwrites the client-IP header.
INQUIRY_TRUST_PROXY_HEADER=false

# Leave false until the owner finalizes and publishes the actual storage agreement.
STORAGE_AGREEMENT_FINALIZED=false
