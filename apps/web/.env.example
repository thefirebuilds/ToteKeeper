# Local sandbox only. Never put server secrets in VITE_* variables or commit .env.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=
SANDBOX_DATABASE_PATH=.sandbox/payments.sqlite
SANDBOX_PORT=4242
SANDBOX_APP_ORIGIN=http://127.0.0.1:5173
# Generate separate random tokens locally (at least 24 characters). No default login.
SANDBOX_CUSTOMER_TOKEN=
SANDBOX_OWNER_TOKEN=
# Provide reviewed test terms yourself. This does not approve production legal terms.
SANDBOX_AGREEMENT_FILE=
SANDBOX_AGREEMENT_VERSION=
SANDBOX_AGREEMENT_APPROVED=false
SANDBOX_BULKY_ADDON_COUPLING_APPROVED=false
# unconfigured blocks Checkout. Explicit disabled preserves an approved no-tax test policy.
STRIPE_TAX_MODE=unconfigured
SANDBOX_TAX_POLICY_APPROVED=false
STRIPE_TAX_BEHAVIOR=
STRIPE_STORAGE_TAX_CODE=
STRIPE_SERVICE_TAX_CODE=
STRIPE_SETUP_TAX_CODE=
STRIPE_TAX_ORIGIN_CONFIGURED=false
STRIPE_TAX_REGISTRATIONS_CONFIGURED=false
# Frontend opt-in: shows separate sandbox controls; does not activate live payments.
VITE_STRIPE_SANDBOX_ENABLED=false

# Optional public customer portal origin. Defaults to portal.<website host>; localhost uses port 8000.
VITE_CUSTOMER_PORTAL_URL=
